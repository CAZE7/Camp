+    branches: ["feature/react-flow-cable-editor-7322653268250495059"]
   workflow_dispatch:
 
 # Standard: nur Lesen. Schreibrechte werden pro Job vergeben.
@@ -20,12 +30,15 @@ permissions:
   contents: read
 
 concurrency:
-  group: pages-${{ github.ref == format('refs/heads/{0}', github.event.repository.default_branch) }}
-  # Concurrency nach Default-Branch gescopt: Nur echte Deploys auf dem
-  # Default-Branch (pages-true) brechen veraltete Deploy-Läufe ab.
-  # Pushes auf Feature-/Dependabot-Branches (pages-false) laufen isoliert
-  # und canceln keine aktiven Deployments.
-  cancel-in-progress: true
+  # Genau ein Deploy-Vorgang gleichzeitig. Ein laufender Produktiv-Deploy
+  # wird NIEMALS abgebrochen (cancel-in-progress: false) — Befund: mit
+  # cancel-in-progress: true gingen am 31.08.2026 zwei Deploy-Runs nach
