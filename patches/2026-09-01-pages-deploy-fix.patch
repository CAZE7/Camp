From fa674e917688da3cb668803b36c357e6c7cebb1d Mon Sep 17 00:00:00 2001
From: CAZE7 <215507980+CAZE7@users.noreply.github.com>
Date: Tue, 1 Sep 2026 14:25:56 +0000
Subject: [PATCH] fix(ci): Pages-Deploys nicht mehr canceln; Trigger auf
 Release-Branch begrenzen

Evidenzbasierte Ursachen (gh run list/view, gh api):
- cancel-in-progress: true in der Concurrency-Gruppe pages-true hat am
  31.08.2026 zwei Produktiv-Deploys nach schnell aufeinanderfolgenden
  Merges abgebrochen (Runs 33373496497, 33373509862: 'Canceling since a
  higher priority waiting request for pages exists'). Pages blieb dadurch
  auf dem Stand vom 29.08.
- on.push.branches-ignore: [gh-pages] loeste bei jedem der 100+ Agent-/
  Dependabot-Branches einen Run aus, in dem alle Jobs wegen des
  Default-Branch-if uebersprungen wurden (13 der letzten 20 Runs =
  Skipped-Rauschen).

Fix (minimal, nur Workflows + Tests + Dokukopie):
- deploy.yml: push-Trigger auf den Release-Branch (Default) begrenzt,
  workflow_dispatch bleibt; if-Default-Branch-Schutz an allen Jobs bleibt.
- Concurrency: group 'pages', cancel-in-progress: false -> laufende
  Deploys laufen fertig, neue Runs reihen sich ein (neuester wartender
  Run ersetzt aeltere).
- scripts/ci/workflows.test.ts: beide Tests an das korrigierte Verhalten
  angepasst; docs/ci/workflows/deploy.yml 1:1 synchron (Test erzwingt es).

Verifiziert lokal: npx vitest run scripts/ci/workflows.test.ts (21/21),
npx tsc -p tsconfig.tests.json --noEmit, prettier --check (alle gruen).
---
 .github/workflows/deploy.yml | 27 ++++++++++++++++++++-------
 docs/ci/workflows/deploy.yml | 27 ++++++++++++++++++++-------
 scripts/ci/workflows.test.ts | 31 +++++++++++++++++++++++++------
 3 files changed, 65 insertions(+), 20 deletions(-)

diff --git a/.github/workflows/deploy.yml b/.github/workflows/deploy.yml
index 98f0ff4..eacbe11 100644
--- a/.github/workflows/deploy.yml
+++ b/.github/workflows/deploy.yml
@@ -12,7 +12,17 @@ name: Deploy to GitHub Pages
 
 on:
   push:
-    branches-ignore: ["gh-pages"]
+    # Nur Pushes auf den Release-Branch lösen den Workflow aus.
+    # Vorher triggerte `branches-ignore` bei JEDEM der 100+ Agent-/
+    # Dependabot-Branches einen Run, in dem dann alle Jobs übersprungen
+    # wurden („Skipped“-Rauschen, Befund: 13 der letzten 20 Runs ohne
+    # Wirkung) und die Actions-Warteschlange belegt war.
+    # WICHTIG: `branches` kann keine Ausdrücke auswerten. Wechselt der
+    # Default-Branch des Repos, muss diese Liste manuell mitwandern —
+    # der `if`-Schutz an den Jobs (Default-Branch-Vergleich) bleibt davon
+    # unberührt und verhindert weiterhin Deploys von falschen Branches
+    # (z. B. bei workflow_dispatch).
+    branches: ["feature/react-flow-cable-editor-7322653268250495059"]
   workflow_dispatch:
 
 # Standard: nur Lesen. Schreibrechte werden pro Job vergeben.
@@ -20,12 +30,15 @@ permissions:
   contents: read
 
 concurrency:
-  group: pages-${{ github.ref == format('refs/heads/{0}', github.event.repository.default_branch) }}
-  # Concurrency nach Default-Branch gescopt: Nur echte Deploys auf dem
-  # Default-Branch (pages-true) brechen veraltete Deploy-Läufe ab.
-  # Pushes auf Feature-/Dependabot-Branches (pages-false) laufen isoliert
-  # und canceln keine aktiven Deployments.
-  cancel-in-progress: true
+  # Genau ein Deploy-Vorgang gleichzeitig. Ein laufender Produktiv-Deploy
+  # wird NIEMALS abgebrochen (cancel-in-progress: false) — Befund: mit
+  # cancel-in-progress: true gingen am 31.08.2026 zwei Deploy-Runs nach
+  # schnell aufeinanderfolgenden Merges verloren (Runs 33373496497 und
+  # 33373509862, „Canceling since a higher priority waiting request for
+  # pages exists“). Neue Runs reihen sich stattdessen in die Warteschlange
+  # ein; der jeweils neueste wartende Run ersetzt ältere wartende.
+  group: "pages"
+  cancel-in-progress: false
 
 env:
   NEXT_TELEMETRY_DISABLED: 1
