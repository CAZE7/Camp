+    touch-action: none; /* Der Griff zieht — er scrollt nicht. */
+    cursor: grab;
+  }
+
+  .node-symbol {
+    display: flex;
+    align-items: center;
+    justify-content: space-between;
+    gap: 0.5rem;
+    margin: -0.15rem -0.15rem 0.7rem;
+    padding: 0.45rem 0.55rem;
+    border-bottom: 1px solid currentColor;
+    color: var(--node-symbol-color, var(--ink));
+    background: var(--node-symbol-bg, #f4f5f7);
+    border-radius: 0.2rem;
+  }
+  .node-symbol__icon {
+    display: grid;
+    place-items: center;
+    width: 2rem;
+    height: 2rem;
+    border: 1px solid currentColor;
+    border-radius: 50%;
+  }
+  .node-symbol__code {
+    font-family: var(--font-mono);
+    font-size: 0.68rem;
+    font-weight: 600;
+    letter-spacing: 0.12em;
+  }
+  /* D-4: Domain-Tints über Signaltokens gemischt — hell und dunkel korrekt. */
+  .node-symbol--dc {
+    --node-symbol-color: var(--wire-dc);
+    --node-symbol-bg: color-mix(in srgb, var(--wire-dc) 10%, var(--surface-panel));
+  }
+  .node-symbol--ac {
+    --node-symbol-color: var(--wire-ac);
+    --node-symbol-bg: color-mix(in srgb, var(--wire-ac) 10%, var(--surface-panel));
+  }
+  .node-symbol--solar {
+    --node-symbol-color: var(--wire-solar);
+    --node-symbol-bg: color-mix(in srgb, var(--wire-solar) 12%, var(--surface-panel));
+  }
+  .node-symbol--load {
+    --node-symbol-color: var(--ok);
+    --node-symbol-bg: color-mix(in srgb, var(--ok) 10%, var(--surface-panel));
+  }
+  .node-symbol--protect {
+    --node-symbol-color: var(--wire-dc);
+    --node-symbol-bg: color-mix(in srgb, var(--wire-dc) 10%, var(--surface-panel));
+  }
+  .node-symbol--ground {
+    --node-symbol-color: var(--text-low);
+    --node-symbol-bg: color-mix(in srgb, var(--text-low) 10%, var(--surface-panel));
+  }
+  .node-symbol--measure {
+    --node-symbol-color: var(--wire-ac);
+    --node-symbol-bg: color-mix(in srgb, var(--wire-ac) 8%, var(--surface-panel));
+  }
+  .node-drag-handle:active {
+    cursor: grabbing;
+  }
+  /* Mit Maus ist der ganze Node greifbar — dann stört der Griff nur. */
+  @media (pointer: fine) {
+    .node-drag-handle {
+      display: none;
+    }
+  }
+  /* Per Long-Press scharfgeschalteter Node: sichtbar „entsperrt“. */
+  .react-flow__node.node-drag-armed {
+    outline: 2px dashed var(--copper);
+    outline-offset: 4px;
+  }
+
+  /* Kabel-Labels bleiben bei jedem Zoom sichtbar (M8-1). Auf schmalen
+     Displays nur die Schrift etwas dichter, nie display:none —
+     D-2 hält die 12-px-Lesbarkeitsgrenze ein. */
+  @media (max-width: 767px) {
+    .edge-label {
+      font-size: 12px;
+      padding: 1px 4px;
+    }
+  }
+
+  /* Große, sichtbare Anschlussflächen für Touch und Tastatur. */
+  .react-flow__handle {
+    width: 44px !important;
+    height: 44px !important;
+    border: 0 !important;
+    background: transparent !important;
+  }
+
+  /* D-4: 12-px-Anschluss, Hover vergrößert auf 14 px und färbt akzentuiert. */
+  .react-flow__handle > div {
+    width: 12px !important;
+    height: 12px !important;
+    border: 2px solid var(--surface-panel);
+    box-shadow: 0 0 0 1px var(--rule-strong);
+    transition:
+      width 150ms ease,
+      height 150ms ease,
+      box-shadow 150ms ease;
+  }
+  .react-flow__handle:hover > div {
+    width: 14px !important;
+    height: 14px !important;
+    box-shadow: 0 0 0 1.5px var(--accent-line);
+  }
+
+  .react-flow__handle:focus-visible > div,
+  .react-flow__handle.connecting > div,
+  .react-flow__handle.tap-connect-selected > div {
+    box-shadow:
+      0 0 0 4px var(--bone),
+      0 0 0 7px var(--wire-selected);
+  }
+
+  .react-flow__handle.valid > div {
+    box-shadow:
+      0 0 0 4px var(--bone),
+      0 0 0 7px var(--success);
+  }
+
+  .react-flow__handle[data-handleid*='plus'] > div,
+  .react-flow__handle[data-handleid='in'] > div {
+    border-radius: 9999px !important;
+  }
+
+  .react-flow__handle[data-handleid*='minus'] > div,
+  .react-flow__handle[data-handleid='out'] > div {
+    border-radius: 2px !important;
+  }
+
+  .react-flow__handle[data-handleid*='ac'] > div {
+    border-radius: 2px !important;
+    transform: rotate(45deg);
+  }
+
+  /* M8-1: keine Zoom-Stufen mehr. Der Wrapper nimmt keinen Platz weg. */
+  .node-presentation-shell {
+    display: contents;
+  }
+
+  /* M8-3: Karten haben eine Mindestbreite und brechen lange Inter-Texte,
+     statt sie über Nachbarn zu schieben. `overflow: visible` (statt hidden):
+     Anschlusspunkte sitzen auf der Rahmenlinie und der Touch-Drag-Griff
+     ragt über die Kartenkante hinaus — beides würde mit hidden abgeschnitten
+     (Griff war auf Touch praktisch unsichtbar). Brechen übernimmt
+     `overflow-wrap: anywhere`. */
+  .react-flow__node .custom-drag-handle,
+  .react-flow__node [data-testid='planner-node'] {
+    min-width: 12rem;
+    overflow: visible;
+    overflow-wrap: anywhere;
+  }
+
+  /* Auto-layout animates position changes; collision resolution uses the same
+     short transform transition and announces itself via a red outline. */
+  .react-flow__node:not(.dragging),
+  .planner-layout-animating .react-flow__node,
+  .react-flow__node.planner-node-collision {
+    transition:
+      transform 300ms ease,
+      opacity 180ms ease;
+  }
+  .react-flow__node.planner-node-collision {
+    outline: 3px solid var(--wire-error);
+    outline-offset: 5px;
+  }
+  .react-flow__node.planner-backbone-group-node {
+    pointer-events: none !important;
+    z-index: -10 !important;
+  }
+
+  .react-flow__node.planner-trace-dim,
+  .react-flow__edge.planner-trace-dim {
+    opacity: 0.2;
+  }
+  .react-flow__node.planner-trace-active,
+  .react-flow__edge.planner-trace-active {
+    opacity: 1;
+  }
+
+  .react-flow__node.planner-focus-dim,
+  .react-flow__edge.planner-focus-dim {
+    opacity: var(--canvas-dim);
+  }
+
+  .react-flow__node.planner-domain-dim,
+  .react-flow__edge.planner-domain-dim {
+    opacity: var(--canvas-domain-dim);
+  }
+
+  /* Fehler-Kabel: "marschierende" gestrichelte Linie als zusätzliches Signal. */
+  .planner-edge-error-dash {
+    animation: wire-error-dash 1s linear infinite;
+  }
+
+  @keyframes wire-error-dash {
+    to {
+      stroke-dashoffset: -28;
+    }
+  }
+
+  /* --- D-4: Anschlusspunkte auf der Kartenkante ------------------------
+     React Flows Default-Offset (-4 px) galt für 6-px-Handles; unsere
+     Trefferfläche ist 44 px. Ohne Gegenrechnung sitzt der sichtbare Punkt
+     ~18 px IMMER im Karteninneren und überdeckt Text/Kante (Batterie-Titel,
+     „BAT"-Code) und Kabel enden sichtbar im Kartenbauch. Mit -22 px liegt
+     der Punkt-Mittelpunkt exakt auf der Rahmenlinie — wie Anschlusspunkte
+     in CAD-Schaltplänen; Kabel enden an der Kante. Voraussetzung ist das
+     `overflow: visible` unten (sonst schneidet die Karte den halben Punkt
+     und den Touch-Drag-Griff ab). */
+  .planner-shell .react-flow__handle-left {
+    left: -22px;
+  }
+  .planner-shell .react-flow__handle-right {
+    right: -22px;
+  }
+  .planner-shell .react-flow__handle-top {
+    top: -22px;
+  }
+  .planner-shell .react-flow__handle-bottom {
+    bottom: -22px;
+  }
+
+  .roof-dot-grid {
+    background-image: radial-gradient(var(--ink) 1px, transparent 1px);
+    background-size: 20px 20px;
+  }
+
+  .roof-solar-grid {
+    background-image:
+      linear-gradient(to right, var(--muted-ink) 1px, transparent 1px),
+      linear-gradient(to bottom, var(--muted-ink) 1px, transparent 1px);
+    background-size: 10px 10px;
+  }
+}
+
+@media (prefers-reduced-motion: reduce) {
+  html {
+    scroll-behavior: auto;
+  }
+
+  *,
+  *::before,
+  *::after {
+    animation-duration: 0.01ms !important;
+    animation-iteration-count: 1 !important;
+    transition-duration: 0.01ms !important;
+  }
+
+  /* Skeletons stehen still, aber sichtbar (dauerhaft auf 55 % Fläche). */
+  .skeleton {
+    animation: none;
+    opacity: 0.55;
+  }
+
+  .planner-flow-particle {
+    display: none;
+  }
+
+  /* GSAP-Timelines respektieren dies nicht automatisch — die Client-
+     Komponente RoadTripAnimation prüft matchMedia zusätzlich und rendert
+     dann statisch. Hier verstecken wir den fahrenden Camper zur Sicherheit. */
+  .road-trip-animation .road-trip-camper {
+    opacity: 0 !important;
+    transform: none !important;
+  }
+}
+
+/* --- Mission 7 (M7-2/M7-3/M7-4): Planer-Schrift, Dichte, Statuszeile --- */
+
+/* M7-2/D-2: Die GESAMTE Seite läuft auf Inter (D-2); Outfit ist echten
+   Display-Headlines vorbehalten. Im Planer ist alles UI — display/heading
+   biegen im planner-shell-Scope deshalb zurück auf Inter, damit CardTitle
+   & Co. nicht in die Marketing-Schrift kippen. Werte: IBM Plex Mono mit
+   tabular-nums. */
+.planner-shell {
+  --font-display: 'Inter Variable', ui-sans-serif, system-ui, sans-serif;
+  --font-heading: 'Inter Variable', ui-sans-serif, system-ui, sans-serif;
+  --space-1: 4px;
+}
+
+.font-mono {
+  font-variant-numeric: tabular-nums;
+}
+
+/* M10-2: Hover / Active / Focus / Disabled an jedem Control, hell + dunkel. */
+.planner-shell .react-flow__controls-button:hover:not(:disabled) {
+  background-color: var(--surface-2);
+  color: var(--text-high);
+}
+.planner-shell button:active:not(:disabled) {
+  filter: brightness(0.96);
+}
+.planner-shell button:focus-visible,
+.planner-shell .react-flow__controls-button:focus-visible,
+.planner-shell a:focus-visible {
+  outline: 2px solid var(--accent-line);
+  outline-offset: 2px;
+}
+.planner-shell button:disabled,
+.planner-shell .react-flow__controls-button:disabled {
+  cursor: not-allowed;
+  opacity: 0.4;
+}
+
+/* D-4: Zoom-Controls im Werft-Panel-Stil. React Flows mitgeliefertes
+   style.css härtert `#fefefe`-Buttons auf weißer Fläche mit #eee-Trennern —
+   im dunklen Theme leuchteten die Buttons als weiße Kacheln aus der Fläche
+   heraus. Token-Werte überschreiben beider Themes korrekt; das SVG folgt
+   `currentColor`. */
+.planner-shell .react-flow__controls {
+  background: var(--surface-1);
+  box-shadow: 0 1px 4px color-mix(in srgb, var(--text-high) 18%, transparent);
+}
+/* Canvas zoom actions are used on phones and tablets as well as desktop.
+   Keep every button at Apple's 44 px recommendation (well above WCAG 2.5.8's
+   24 px floor) instead of React Flow's compact 26/32 px defaults. */
+.planner-shell .react-flow__controls-button {
+  width: 2.75rem;
+  height: 2.75rem;
+  background: var(--surface-1);
+  color: var(--text-med);
+  border-bottom: 1px solid var(--rule);
+  fill: currentColor;
+}
+.planner-shell .react-flow__controls-button:last-child {
+  border-bottom: 0;
+}
+.planner-shell .react-flow__controls-button svg {
+  fill: currentColor;
+}
+
+/* Die React-Flow-Attribution bleibt (Lizenz), aber dezent: kein weißer
+   Kasten auf dunkler Fläche. */
+.planner-shell .react-flow__attribution {
+  background: transparent;
+}
+.planner-shell .react-flow__attribution a {
+  color: var(--text-low);
+}
+.planner-shell .react-flow__attribution a:hover {
+  color: var(--oxide);
+}
+
+/* D-4: MiniMap im Werkzeug-Stil — Panel-Fläche, 1-px-Linie, Radius 4. */
+.planner-shell .react-flow__minimap {
+  border: 1px solid var(--rule);
+  border-radius: 4px;
+  overflow: hidden;
+  box-shadow: none;
+}
+.planner-shell .react-flow__minimap-mask {
+  stroke: var(--accent-line);
+}
+.planner-shell .react-flow__panel {
+  font-family: var(--font-mono);
+}
+
+/* Inspector-Werte: Ziffern rechtsbündig in Plex Mono, damit Einheiten
+   (im Label bzw. Suffix) und Stellenwerte spaltenrein stehen. */
+.planner-shell input[type='number'] {
+  text-align: right;
+  font-family: var(--font-mono);
+  font-variant-numeric: tabular-nums;
+}
+
+/* M7-3 Statuszeile: Cursor-Koordinaten, Zoom, Planumfang — dezent am
+   unteren Rand, Mono-Text auf surface-2. */
+.planner-statusbar {
+  display: flex;
+  flex-wrap: wrap;
+  gap: 0.75rem;
+  align-items: center;
+  padding: 0.25rem 0.5rem;
+  font-family: var(--font-mono);
+  font-size: 0.6875rem;
+  line-height: 1rem;
+  font-variant-numeric: tabular-nums;
+  color: var(--text-med);
+  background: var(--surface-1);
+  border: 1px solid var(--border);
+  border-radius: 2px;
 }
