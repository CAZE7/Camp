+        run: npm run lint
+
+      - name: Format-Check
+        run: npm run format:check
+
       - name: Typecheck (Produktionscode)
         run: npm run typecheck
 
@@ -82,8 +90,10 @@ jobs:
         # Produktionscode — Tests könnten Ampere und Volt vertauschen.
         run: npm run typecheck:tests
 
-      - name: Unit- und Komponententests
-        run: npm test
