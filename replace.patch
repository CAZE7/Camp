    nodeType === 'inverter' && handle && AC_HANDLES.includes(handle);

  if (hasAcHandle(sourceNodeType, sourceHandle) || hasAcHandle(targetNodeType, targetHandle)) {
    return 'AC_230V';
  }
  return 'DC_12V';
};
