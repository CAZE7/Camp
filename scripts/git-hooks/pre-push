#!/usr/bin/env bash
# Pre-Push-Hook: verhindert, dass fehlerhafter Code gepusht wird.
#
# Läuft bei jedem `git push` (sofern hooksPath gesetzt ist — siehe package.json "postinstall").
# Überspringbar mit:  git push --no-verify
set -euo pipefail

cd "$(git rev-parse --show-toplevel)"

echo "▶ [pre-push] TypeScript-Typcheck (tsc --noEmit)..."
npm run typecheck

echo "▶ [pre-push] Tests (vitest)..."
npm test

echo "✔ [pre-push] Alles grün — Push wird fortgesetzt."
