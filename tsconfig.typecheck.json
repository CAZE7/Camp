{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "incremental": false
    // noUncheckedIndexedAccess steht in der Basis-tsconfig — Editor,
    // Produktionscode- und Test-Profil laufen mit derselben Schärfe
    // (kein Profil-Drift).
  },
  "include": ["next-env.d.ts", "**/*.ts", "**/*.tsx"],
  "exclude": [
    "node_modules",
    ".next",
    "out",
    "coverage",
    "**/*.test.ts",
    "**/*.test.tsx",
    "**/__tests__/**",
    "vitest.setup.ts"
  ]
}
