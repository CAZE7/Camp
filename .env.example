# No environment variables are required for the static export.
# All data is stored in the browser (localStorage).

# OPTIONAL — nur für den KI-Assistenten (/ki-assistent):
# Ohne diesen Wert sendet die Seite gegen '/api/chat', das im statischen
# Export nicht existiert (ADR 0001, ADR 0021) — der Chat antwortet dann nicht.
# NEXT_PUBLIC_CHAT_API_URL=https://example.org/api/chat
# NEXT_PUBLIC_CHAT_TOKEN=
