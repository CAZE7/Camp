# Optional: absolute URL to a deployed chat backend when the app is hosted statically.
# Leave empty in Node/Edge deployments where /api/chat is served by the same app.
NEXT_PUBLIC_CHAT_API=

# Set to "false" to hide the AI assistant entirely.
NEXT_PUBLIC_CHAT_ENABLED=

# Server-side only: used by app/api/chat/route.ts when the API route is deployed.
OPENAI_API_KEY=
DATABASE_URL=
